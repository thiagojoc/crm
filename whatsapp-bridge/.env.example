# copie esse arquivo pra ".env" (sem o .example) e preencha os valores reais.
# o .env nunca deve ser commitado (ja esta no .gitignore).

# qualquer texto longo e dificil de adivinhar; vai tambem na URL do webhook
# configurada no Evolution API, entao so quem conhece essa URL consegue
# criar lead no CRM.
WEBHOOK_SECRET=troque-por-um-texto-aleatorio-longo

# o id do workspace do Vinicius dentro de crm_sjc (aparece na URL do CRM
# depois de trocar pra conta dele, ou no console do Firebase em
# Firestore Database > crm_sjc > <aqui>).
CRM_WORKSPACE_ID=

# caminho pro arquivo da chave de servico baixada no console do Firebase
# (Configuracoes do projeto > Contas de servico > Gerar nova chave privada).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# pipeline/etapa onde o lead novo entra (os ids padrao do CRM; so muda se
# o Vinicius tiver renomeado/criado outro pipeline).
DEFAULT_PIPELINE_ID=pl-sdr
DEFAULT_STAGE_ID=novo

# tags aplicadas automaticamente no lead, pra filtrar facil no CRM quem
# veio do WhatsApp.
DEFAULT_TAGS=lead-whatsapp

PORT=3000
